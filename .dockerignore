# Build context filter for docker/Dockerfile.api and docker/Dockerfile.web.
# Patterns are relative to the repository root (a bare `name` matches only at the root).

# VCS / tooling
.git
.github
.gitignore
.editorconfig
.pre-commit-config.yaml

# dependencies & virtualenvs (reinstalled inside the image)
node_modules
**/node_modules
.venv
.pnpm-store
__pycache__
**/__pycache__
*.py[cod]
*.egg-info

# build output
.next
**/.next
out
dist
build
*.tsbuildinfo

# caches
.mypy_cache
.ruff_cache
.pytest_cache
coverage
.coverage
htmlcov
playwright-report
test-results
blob-report

# local env & data (never bake secrets into an image)
.env
.env.*
!.env.example
var
storage
*.log
.DS_Store

# not needed at runtime: tests, docs, deployment manifests, local-stack configs
tests
docs
deploy
docker-compose.yml
docker/egress-proxy
docker/minio
docker/observability
docker/temporal
*.md
!README.md

# developer-only scripts (scripts/seed_demo.py and scripts/seed_lab_demo.py ARE
# needed: docker/init.sh runs them)
scripts/dev.mjs
scripts/register_ollama_qwen.py
scripts/test_audit_qwen.py
