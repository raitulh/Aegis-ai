{
  "benchmark_fixture": true,
  "fixture_notice": "BENCHMARK FIXTURE - synthetic cases authored for internal regression benchmarking of the AI Scientist Evolution Lab. Documents, hypotheses, designs and numbers are illustrative; they are not research findings, not real data and must never be presented as discoveries.",
  "suite": "experiment_design_bench",
  "version": "1.0.0",
  "description": "Detect experiment-design issues. Subject returns issue codes from the declared vocabulary; scored by micro precision/recall/F1 over issue codes (clean designs expect an empty list).",
  "issue_vocabulary": {
    "MISSING_CONTROL": "No control or baseline arm to compare against.",
    "INSUFFICIENT_SEEDS": "Fewer than 3 independent seeds/replicates per arm.",
    "DATA_LEAKAGE": "Information from the evaluation data reaches training (overlapping groups, preprocessing fitted on all data, tuning on the test set).",
    "NO_PRIMARY_METRIC": "No pre-specified primary metric.",
    "MULTIPLE_COMPARISONS_UNCORRECTED": "Five or more hypothesis tests (metrics x arms) without a multiple-comparison correction.",
    "CONFOUNDED_VARIABLES": "An arm changes more than one factor relative to the control, so effects cannot be attributed.",
    "UNDERPOWERED": "No power analysis and fewer than 30 units per arm for an expected small effect (standardised effect < 0.5).",
    "NO_RANDOMIZATION": "Units are assigned to arms non-randomly (sequentially or by hand)."
  },
