# ==============================================================================
# Aegis AI — environment configuration
#
#   cp .env.example .env      # then edit; NEVER commit .env or real secrets
#
# Every setting in apps/api/aegis_api/config.py is listed here (env var = upper-case
# field name). Values below are development defaults. Settings marked
#   [required in production]
# must be set (the app refuses to start with ENVIRONMENT=production without them);
# development-only fallbacks are derived deterministically and flagged loudly at startup.
#
# Two consumers read this file:
#   * the Python processes started on the host (scripts/run-*.sh source it) — host
#     addresses (localhost) below are for them;
#   * docker compose (variable interpolation only). Inside containers the infra
#     addresses (db, redis, temporal, minio) are fixed by docker-compose.yml, so the
#     localhost values here never leak into the stack.
#
# Format rules (the file is also `source`d by bash): quote values that contain
# spaces, <, >, or JSON; leave optional *text* settings blank (`KEY=` with nothing
# after it — an inline comment after an empty value becomes the value) to unset
# them, but COMMENT OUT unset enum/number/boolean settings (blank is not "unset" for them).
# ==============================================================================

# --- runtime ------------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production (alias: APP_ENV)
LOG_LEVEL=INFO
LOG_JSON=false                          # true in containers / production (structured logs)
API_BASE_URL=http://localhost:8000      # public API origin (alias: APP_URL)
WEB_BASE_URL=http://localhost:3000
# APP_NAME=Aegis AI
# APP_VERSION=1.0.0

# --- database (PostgreSQL 16 + pgvector) --------------------------------------
# [required in production] The API/workers connect as the application role (RLS enforced).
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis
# [required in production] Owner/admin role for migrations, seeding, the identity layer and cross-tenant
# maintenance (bypasses RLS). Without it the app role is used and those paths fail under RLS.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/aegis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false                           # log every SQL statement (debug only; never in production)

# --- queue / workers / events -------------------------------------------------
# With REDIS_URL set, JOB_BACKEND defaults to celery and the event bus to redis; without it, jobs run
# in-process and SSE notifications use an in-memory bus (single process only).
REDIS_URL=redis://localhost:6379/0
JOB_BACKEND=celery                      # celery | inline
INLINE_JOB_WORKERS=2
# EVENT_BUS_BACKEND=redis               # redis | memory (default: redis when REDIS_URL is set)
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_STREAM_SECONDS=3600
IDEMPOTENCY_TTL_HOURS=24

# --- authentication (sessions) --------------------------------------------------
LOCAL_AUTH_ENABLED=true
SESSION_TTL_HOURS=168
GUEST_SESSION_TTL_HOURS=12
# Supabase Auth (optional — leave blank to use self-hosted local auth only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# server-side only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- API tokens (JWT access + rotating refresh) -------------------------------
# [required in production] HS256 signing key for access tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# Zero-downtime rotation: publish old + new keys by kid, sign with JWT_ACTIVE_KID. Example:
# JWT_SECRETS_JSON='{"kid-2026-09":"<new secret>","kid-2026-06":"<old secret>"}'
JWT_SECRETS_JSON={}
JWT_ACTIVE_KID=primary
JWT_ISSUER=aegis-lab
JWT_AUDIENCE=aegis-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- OAuth / OIDC single sign-on ------------------------------------------------
# Identity providers are configured per organization through the API (admin endpoints), not here.
# Base URL for the OIDC callback (…/api/v1/auth/oidc/callback); blank → API_BASE_URL.
OIDC_REDIRECT_BASE_URL=

# --- secrets (required in production) -------------------------------------------
# [required in production] Fernet key encrypting stored secrets (provider keys, webhook secrets, IdP secrets).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# [required in production] Pepper for API-key hashing; also derives signed-URL and agent-message HMAC keys.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_PEPPER=

# --- HTTP hardening / rate limits ---------------------------------------------
CORS_ORIGINS=http://localhost:3000      # comma-separated exact origins
MAX_REQUEST_BYTES=2097152
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=600
RATE_LIMIT_EXPENSIVE_PER_MIN=20
# Lab tiers (per tenant and per credential)
RATE_LIMIT_RESEARCH_PER_MIN=10
RATE_LIMIT_EXECUTION_PER_MIN=20
RATE_LIMIT_MODEL_PER_MIN=120
RATE_LIMIT_DOWNLOAD_PER_MIN=120
ALLOW_PRIVATE_NETWORK_TARGETS=false     # true only for local dev against private endpoints (SSRF guard)

# --- evidence storage (assurance platform) ------------------------------------
STORAGE_BACKEND=local                   # local | supabase
STORAGE_LOCAL_DIR=var/storage
STORAGE_BUCKET=aegis-evidence

# --- lab object storage (artifacts, datasets, logs) ---------------------------
# local: files under OBJECT_STORAGE_LOCAL_DIR (single host; the Kubernetes execution backend needs s3).
# s3: any S3-compatible store — MinIO (docker compose: http://localhost:9000), AWS S3, R2, GCS interop.
OBJECT_STORAGE_BACKEND=local            # local | s3
# e.g. http://localhost:9000 (blank = AWS default endpoint)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=aegis-lab
# [required in production when OBJECT_STORAGE_BACKEND=s3] Use a bucket-scoped key, never root credentials.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true    # true for MinIO / most S3-compatible stores
OBJECT_STORAGE_LOCAL_DIR=var/objects
SIGNED_URL_TTL_SECONDS=900
MAX_ARTIFACT_BYTES=5368709120           # 5 GiB
MAX_LAB_UPLOAD_BYTES=209715200          # 200 MiB
MALWARE_SCANNER=none                    # none | clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- workflows (Temporal) -------------------------------------------------------
# Blank TEMPORAL_ADDRESS → local durable workflow engine (runs inside the API/Celery processes; the
# scheduler resumes stale runs). Set it (e.g. localhost:7233 with `docker compose up temporal`) to use
# Temporal + `scripts/run-temporal-worker.sh`.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aegis-lab
TEMPORAL_EXECUTION_TASK_QUEUE=aegis-lab-execution
TEMPORAL_TLS=false                      # true for Temporal Cloud / mTLS-terminated endpoints
# Temporal Cloud API key (secret)
TEMPORAL_API_KEY=
TEMPORAL_CONNECT_TIMEOUT_SECONDS=5
# WORKFLOW_ENGINE=temporal              # temporal | local (default: temporal when TEMPORAL_ADDRESS is set)
WORKFLOW_STALE_AFTER_SECONDS=300        # local engine: resume RUNNING runs with no heartbeat

# --- AI providers ---------------------------------------------------------------
# All optional: without keys the hash embedder and deterministic engines keep working; lab LLM features
# fail explicitly (ModelUnavailable) instead of pretending. Organizations must also consent to external
# processing (data_processing.allow_external_llm) before any provider is called for them.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_REASONING_MODEL=
EMBEDDING_PROVIDER=hash                 # hash (local, no service) | ollama | gemini | openai
EMBEDDING_DIM=768
MODEL_TIMEOUT_SECONDS=60

# --- LLM gateway (provider-agnostic routing, retries, budgets) ------------------
LLM_DEFAULT_PROVIDER=gemini             # gemini | openai | anthropic | ollama
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=8192

# --- Gemini (Google AI) -----------------------------------------------------------
# Model ids are configuration, never hard-coded in logic. Stable aliases are the defaults; the concrete
# modelVersion returned by the API is recorded on every call for reproducibility.
# secret
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-latest        # used by the assurance platform and as the lab default fallback
# lab "default" tier; blank → GEMINI_MODEL
GEMINI_DEFAULT_MODEL=
GEMINI_REASONING_MODEL=gemini-pro-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_DEEP_RESEARCH_AGENT=deep-research-preview-04-2026   # Interactions API agent id
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3

# --- model pricing (cost reporting) -------------------------------------------
# Cost is only reported when a price is configured (never invented). Keys are "provider:model" and are
# matched against the requested model id, then the returned model version, then a bare "provider" key;
# per-organization prices in model_configs take precedence. USD per 1M tokens; optional
# "cached_input_per_mtok". Example — VERIFY AGAINST THE OFFICIAL PRICING PAGE before relying on it
# (https://ai.google.dev/gemini-api/docs/pricing):
# MODEL_PRICING_JSON='{"gemini:gemini-3.8-flash":{"input_per_mtok":1.50,"output_per_mtok":7.50}}'
MODEL_PRICING_JSON={}

# --- execution fabric (sandboxed experiments) --------------------------------------
# The API never executes experiment code: only the execution-queue worker does.
#   local_docker — Docker Engine API over DOCKER_HOST (access to the socket == root on that host: dev only)
#   kubernetes   — batch/v1 Jobs in K8S_NAMESPACE (production; see deploy/k8s)
#   disabled     — experiments cannot run
EXECUTION_BACKEND=local_docker          # local_docker | kubernetes | disabled
DOCKER_HOST=unix:///var/run/docker.sock
EXECUTION_DEFAULT_IMAGE=python:3.12-slim
# Comma-separated allowlist (exact refs or prefixes ending with '*'). Pin digests in production.
EXECUTION_ALLOWED_IMAGES=python:3.12-slim,python:3.11-slim
EXECUTION_USER=65534:65534
EXECUTION_MAX_CPU=4.0
EXECUTION_MAX_MEMORY_MB=8192
EXECUTION_MAX_DISK_MB=10240
EXECUTION_MAX_TIMEOUT_SECONDS=21600
EXECUTION_DEFAULT_TIMEOUT_SECONDS=900
EXECUTION_MAX_OUTPUT_BYTES=536870912
EXECUTION_MAX_OUTPUT_FILES=2000
EXECUTION_MAX_LOG_BYTES=10485760
EXECUTION_PIDS_LIMIT=256
EXECUTION_TMPFS_MB=256
EXECUTION_GPU_ENABLED=false             # also needs the org policy + FEATURE_GPU_EXECUTION
EXECUTION_CPU_PRICE_PER_HOUR_USD=0.0
EXECUTION_MEMORY_GB_PRICE_PER_HOUR_USD=0.0
EXECUTION_GPU_PRICE_PER_HOUR_JSON={}    # e.g. '{"nvidia-l4":0.80}' (quoted)
# Network mode "allowlist": sandboxes join EXECUTION_EGRESS_NETWORK (Docker, internal) whose only way out is
# the allowlisting proxy. Blank → only network mode "none" is available. docker compose: enable the
# `egress` profile and set aegis-sandbox-egress / http://egress-proxy:8888.
EXECUTION_EGRESS_NETWORK=
EXECUTION_EGRESS_PROXY_URL=
# Kubernetes backend (EXECUTION_BACKEND=kubernetes; in-cluster service-account credentials)
K8S_API_URL=https://kubernetes.default.svc
K8S_NAMESPACE=aegis-sandbox
K8S_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
K8S_CA_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# e.g. gvisor (see deploy/k8s/examples/runtimeclass-gvisor.yaml)
K8S_RUNTIME_CLASS=
K8S_IMAGE_PULL_SECRET=
K8S_FETCHER_IMAGE=curlimages/curl:8.10.1

# --- research tools / MCP -------------------------------------------------------------
PAPER_SEARCH_SOURCES=openalex,arxiv
# polite-pool contact for OpenAlex
OPENALEX_MAILTO=
TOOL_DEFAULT_TIMEOUT_SECONDS=30
URL_FETCH_MAX_BYTES=2097152
# Hosts research tools may reach (exact host or leading-dot suffix). Keep docker/egress-proxy/allowlist.txt
# no broader than this list.
TOOL_EGRESS_ALLOWLIST=api.openalex.org,export.arxiv.org,arxiv.org,api.crossref.org,.wikipedia.org
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RESPONSE_BYTES=1048576
MCP_PROTOCOL_VERSION=2026-07-28
MCP_LEGACY_PROTOCOL_VERSION=2025-11-25

# --- agents -------------------------------------------------------------------------
AGENT_DEFAULT_MAX_STEPS=8
AGENT_DEFAULT_TIMEOUT_SECONDS=600
AGENT_MAX_TOOL_OUTPUT_CHARS=20000

# --- observability ------------------------------------------------------------------
METRICS_ENABLED=true                    # GET /metrics (Prometheus)
# When set, /metrics requires "Authorization: Bearer <token>" (configure your scraper; the compose
# Prometheus picks it up automatically). Recommended in production.
METRICS_TOKEN=
# OTLP/HTTP collector base URL; blank = tracing off (zero overhead).
# docker compose: http://otel-collector:4318 with the `observability` profile.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aegis-api             # background processes append their role (-worker, -scheduler, …)
OTEL_TRACES_SAMPLER_RATIO=1.0           # 0.0–1.0 parent-based ratio sampling
# Error tracking: no Sentry adapter ships with this codebase; SENTRY_DSN is NOT read by the app.
# SENTRY_DSN=

# Process-level knobs (read only by the process entrypoints; docker-compose / k8s set them per service):
# METRICS_PORT=9102                     # event consumer 9102, scheduler 9103, temporal workers 9104/9105
# EVENT_CONSUMER_INTERVAL_SECONDS=2
# EVENT_CONSUMER_SETTLE_SECONDS=30
# SCHEDULER_INTERVAL_SECONDS=15

# --- billing ------------------------------------------------------------------------
# Usage is metered and costed; no payment provider adapter is included.
BILLING_PROVIDER=none                   # none (placeholder for a future provider adapter)
BILLING_CURRENCY=USD

# --- feature flags (defaults; per-organization overrides live in the database) -------
FEATURE_ADAPTIVE_REDTEAM=true
FEATURE_AGENT_AUDIT=true
FEATURE_CONTINUOUS_MONITORING=true
FEATURE_EXTERNAL_VERIFICATION=false
FEATURE_ENTERPRISE_CONTROLS=false
FEATURE_EVOLUTION=true
FEATURE_DEEP_RESEARCH=true
FEATURE_MCP=true
FEATURE_GPU_EXECUTION=false
FEATURE_ENTERPRISE_SSO=false
FEATURE_VERIFICATION=true
FEATURE_GRAPH_MEMORY=true
FEATURE_BILLING=false

# --- email (optional) ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM="Aegis AI <no-reply@aegis.local>"

# --- demo ---------------------------------------------------------------------------
DEMO_ENABLED=true
DEMO_REFERENCE_ORG_SLUG=aegis-demo

# --- web (Next.js) ------------------------------------------------------------------
# Server-side base the web BFF proxies to (inside Docker: http://api:8000).
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# docker compose only (interpolation knobs; not read by the application)
# ==============================================================================
# COMPOSE_PROFILES=observability,egress # optional services (see docker-compose.yml)
# PUBLISH_ADDRESS=127.0.0.1             # host interface for published ports (0.0.0.0 exposes them)
# Host ports: DB_PORT=5432 REDIS_PORT=6379 API_PORT=8000 WEB_PORT=3000 TEMPORAL_PORT=7233
#             TEMPORAL_UI_PORT=8080 MINIO_PORT=9000 MINIO_CONSOLE_PORT=9001 PROMETHEUS_PORT=9090
#             GRAFANA_PORT=3001 OTEL_HTTP_PORT=4318
# WEB_ORIGIN=http://localhost:3000      # CORS origin + Next.js site URL inside the stack
# WORKER_CONCURRENCY=2                  # Celery worker processes
# DEMO_SEED_ON_INIT=true                # seed the assurance demo on `migrate`
# LAB_DEMO_SEED_ON_INIT=true            # seed the AI Scientist Lab demo on `migrate` (if the script exists)
# AEGIS_API_IMAGE=aegis-api:local       # tag for the API/worker image built by compose
# Execution worker: group id owning the Docker socket (Linux: stat -c %g /var/run/docker.sock) and its path.
# DOCKER_GID=999
# DOCKER_SOCKET=/var/run/docker.sock
# MinIO root credentials (dev-only defaults; the app uses OBJECT_STORAGE_* = a bucket-scoped user
# created by `minio-init`, defaults aegis-lab-app / aegis-lab-app-dev-only-secret).
# MINIO_ROOT_USER=aegis-minio-root
# MINIO_ROOT_PASSWORD=aegis-minio-root-dev-only
# MINIO_IMAGE / MINIO_MC_IMAGE          # override the pinned MinIO images (e.g. an internal mirror)
# TEMPORAL_RETENTION=72h                # workflow history retention for the default namespace
# PROMETHEUS_RETENTION=7d
# GRAFANA_ADMIN_PASSWORD=aegis-grafana-dev-only
