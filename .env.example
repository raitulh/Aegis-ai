# ==============================================================================
# Aegis AI — environment configuration
# Copy to .env and fill in. NEVER commit real secrets. Development-only defaults are
# generated automatically and flagged loudly at startup; production requires the
# secrets marked (required in production) below.
# ==============================================================================

# --- runtime ------------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# --- database (PostgreSQL 16 + pgvector) --------------------------------------
# The API/worker connect as the application role (RLS enforced).
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis
# Owner/admin role used for migrations, seeding and the identity layer (bypasses RLS).
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/aegis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- queue / workers ----------------------------------------------------------
# With REDIS_URL set, JOB_BACKEND defaults to celery; without it, jobs run in-process.
REDIS_URL=redis://localhost:6379/0
JOB_BACKEND=celery                      # celery | inline
INLINE_JOB_WORKERS=2

# --- authentication -----------------------------------------------------------
LOCAL_AUTH_ENABLED=true
SESSION_TTL_HOURS=168
GUEST_SESSION_TTL_HOURS=12
# Supabase Auth (optional — leave blank to use self-hosted local auth only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=              # server-side only — NEVER expose to the browser

# --- secrets (required in production) -----------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_PEPPER=
# Access-token signing key (≥ 32 chars). Generate like API_KEY_PEPPER.
JWT_SIGNING_KEY=
# HMAC key for signed agent-to-agent handoff messages. Generate like API_KEY_PEPPER.
AGENT_MESSAGE_SIGNING_KEY=

# --- HTTP hardening -----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=2097152
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=600
RATE_LIMIT_EXPENSIVE_PER_MIN=20
ALLOW_PRIVATE_NETWORK_TARGETS=false     # true only for local dev against private endpoints

# --- storage ------------------------------------------------------------------
STORAGE_BACKEND=local                   # local | supabase
STORAGE_LOCAL_DIR=var/storage
STORAGE_BUCKET=aegis-evidence

# --- AI providers -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
EMBEDDING_PROVIDER=hash                 # hash (local, no service) | ollama | gemini | openai
EMBEDDING_DIM=768
# Cost is only reported when a price is configured here (never invented):
# {"gemini:gemini-2.5-flash": {"input_per_mtok": 0.10, "output_per_mtok": 0.40}}
MODEL_PRICING_JSON={}

# --- email (optional) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Aegis AI <no-reply@aegis.local>

# --- demo ---------------------------------------------------------------------
DEMO_ENABLED=true
DEMO_REFERENCE_ORG_SLUG=aegis-demo

# --- web (Next.js) ------------------------------------------------------------
# Server-side base the web BFF proxies to (inside Docker: http://api:8000).
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# AI Scientist Evolution Lab
# ==============================================================================

# --- Gemini (primary provider; model ids come from config, never code) --------
# External providers are only used after an organization grants data-processing consent
# (allow_external_models on its quota). Without consent, routing fails closed.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_REVISION=2026-05-20
GEMINI_DEFAULT_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_FAST_MODEL=
GEMINI_DEEP_RESEARCH_AGENT=
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
LLM_DEFAULT_PROVIDER=gemini
# Optional extra catalogue entries / prices (JSON). Costs are only reported when priced.
MODEL_CATALOG_JSON=[]
AGENT_MAX_STEPS=6

# --- durable workflows --------------------------------------------------------
# temporal (recommended) | inline (DB-backed engine driven by `python -m aegis_api.processes.worker`)
WORKFLOW_ENGINE=
TEMPORAL_ADDRESS=                       # e.g. localhost:7233 — setting it selects the Temporal engine
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aegis-lab
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
WORKFLOW_LEASE_SECONDS=300

# --- object storage (artifacts, datasets, reports) ----------------------------
OBJECT_STORAGE_BACKEND=local            # local (dev only) | s3 (MinIO / S3; required in production)
OBJECT_STORAGE_LOCAL_DIR=var/objects
OBJECT_STORAGE_ENDPOINT=                # e.g. http://localhost:9000 for MinIO
OBJECT_STORAGE_PUBLIC_ENDPOINT=         # host clients use for presigned URLs
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=aegis-lab
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=600
MAX_ARTIFACT_UPLOAD_BYTES=209715200
MALWARE_SCANNER=none                    # none | clamav
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- sandboxed execution (generated code never runs in the API) ---------------
EXECUTION_BACKEND=docker                # docker | kubernetes | disabled
DOCKER_HOST=                            # blank = local daemon; compose uses tcp://sandbox:2376
DOCKER_TLS_CERT_DIR=                    # ca.pem/cert.pem/key.pem for a remote TLS daemon
EXECUTION_DEFAULT_IMAGE=python:3.12-alpine
EXECUTION_REQUIRE_DIGEST_PINNED_IMAGES=false   # set true in production
EXECUTION_MAX_CPU=4
EXECUTION_MAX_MEMORY_MB=8192
EXECUTION_MAX_TIMEOUT_SECONDS=3600
EXECUTION_TMPFS_MB=256
KUBERNETES_API_URL=
KUBERNETES_NAMESPACE=aegis-sandbox
KUBERNETES_RUNTIME_CLASS=gvisor
# Compute prices (JSON) — compute cost is only reported when configured.
COMPUTE_PRICING_JSON={}

# --- research / knowledge -----------------------------------------------------
RESEARCH_SEARCH_PROVIDERS=arxiv,crossref
RESEARCH_FETCH_MAX_BYTES=5242880

# --- governance ---------------------------------------------------------------
# Platform-wide autonomy ceiling; organizations may lower (never raise) it.
LAB_PLATFORM_MAX_AUTONOMY=L4_CLOSED_LOOP_EVOLUTION
IDEMPOTENCY_TTL_HOURS=24
RATE_LIMIT_RESEARCH_PER_MIN=6
RATE_LIMIT_EXECUTION_PER_MIN=30
RATE_LIMIT_MODEL_PER_MIN=120
RATE_LIMIT_DOWNLOAD_PER_MIN=120

# --- observability ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=            # OTLP/HTTP, e.g. http://localhost:4318
OTEL_SERVICE_NAME=aegis-api
OTEL_TRACES_SAMPLER_RATIO=1.0
METRICS_ENABLED=true
METRICS_TOKEN=                          # optional bearer token for /metrics

# --- feature flags ------------------------------------------------------------
FEATURE_DEEP_RESEARCH=true
FEATURE_EVOLUTION=true
FEATURE_MCP=true
FEATURE_VERIFICATION=true
FEATURE_GRAPH_MEMORY=true
FEATURE_GPU_EXECUTION=false
FEATURE_ENTERPRISE_SSO=false
FEATURE_BILLING=false

# --- local compose (docker-compose.yml) ---------------------------------------
MINIO_ROOT_USER=aegis
MINIO_ROOT_PASSWORD=aegis-dev-secret    # development only
