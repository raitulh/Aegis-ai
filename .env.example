# ==============================================================================
# Aegis AI — environment configuration
# Copy to .env and fill in. NEVER commit real secrets. Development-only defaults are
# generated automatically and flagged loudly at startup; production requires the
# secrets marked (required in production) below.
# ==============================================================================

# --- runtime ------------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# --- database (PostgreSQL 16 + pgvector) --------------------------------------
# The API/worker connect as the application role (RLS enforced).
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis
# Owner/admin role used for migrations, seeding and the identity layer (bypasses RLS).
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/aegis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- queue / workers ----------------------------------------------------------
# With REDIS_URL set, JOB_BACKEND defaults to celery; without it, jobs run in-process.
REDIS_URL=redis://localhost:6379/0
JOB_BACKEND=celery                      # celery | inline
INLINE_JOB_WORKERS=2

# --- authentication -----------------------------------------------------------
LOCAL_AUTH_ENABLED=true
SESSION_TTL_HOURS=168
GUEST_SESSION_TTL_HOURS=12
# Supabase Auth (optional — leave blank to use self-hosted local auth only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# server-side only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- secrets (required in production) -----------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_PEPPER=

# --- HTTP hardening -----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=2097152
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=600
RATE_LIMIT_EXPENSIVE_PER_MIN=20
# Outbound URLs to private/internal networks: unset = allowed in development, blocked in production.
ALLOW_PRIVATE_NETWORK_TARGETS=
# Number of trusted reverse proxies in front of the API (used to read X-Forwarded-For safely).
TRUSTED_PROXY_HOPS=0
# Extra origins allowed to make cookie-authenticated writes (CORS_ORIGINS and WEB_BASE_URL are included).
CSRF_TRUSTED_ORIGINS=
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900

# --- jobs, scheduler and streaming --------------------------------------------
JOB_LEASE_TIMEOUT_SECONDS=900           # a running job without a heartbeat for this long is recovered
AUDIT_MAX_ATTEMPTS=2
JOB_MAX_ATTEMPTS=3
SCHEDULER_ENABLED=true                  # inline backend: in-process tick; celery backend: run `celery beat`
SCHEDULER_INTERVAL_SECONDS=30
SSE_HEARTBEAT_SECONDS=15
IDEMPOTENCY_TTL_HOURS=24

# --- evidence (required in production) ----------------------------------------
# Ed25519 seed used to sign evidence packages. Keep it stable: rotating it changes the public key.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
EVIDENCE_SIGNING_KEY=

# --- runtime guard ------------------------------------------------------------
RUNTIME_MAX_BATCH=500
RUNTIME_DEFAULT_MODE=observe            # observe | audit | enforce (for newly registered systems)

# --- plans and billing --------------------------------------------------------
BILLING_PROVIDER=none                   # none | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Override plan limits/features/prices per deployment, e.g.
# {"pro": {"price_display": "$99 / month", "limits": {"audit_run": 500}}}
PLANS_JSON={}
# receives /contact requests (needs SMTP)
SALES_INBOX=

# --- retention ----------------------------------------------------------------
RETENTION_RUNTIME_EVENTS_DAYS=30        # plan retention applies when lower/higher; evidence is never purged
RETENTION_AUDIT_EVENTS_DAYS=180
RETENTION_SANDBOX_HOURS_GRACE=1

# --- observability ------------------------------------------------------------
METRICS_ENABLED=true
# required in production; scrape /metrics with "Authorization: Bearer <token>"
METRICS_TOKEN=

# --- storage ------------------------------------------------------------------
STORAGE_BACKEND=local                   # local | supabase
STORAGE_LOCAL_DIR=var/storage
STORAGE_BUCKET=aegis-evidence

# --- AI providers -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
EMBEDDING_PROVIDER=hash                 # hash (local, no service) | ollama | gemini | openai
EMBEDDING_DIM=768
# Cost is only reported when a price is configured here (never invented):
# {"gemini:gemini-2.5-flash": {"input_per_mtok": 0.10, "output_per_mtok": 0.40}}
MODEL_PRICING_JSON={}

# --- email (optional) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Aegis AI <no-reply@aegis.local>

# --- feature flags ------------------------------------------------------------
FEATURE_RUNTIME_ENFORCEMENT=true
FEATURE_AI_ASSISTANT=false
FEATURE_MARKETPLACE=false
FEATURE_SSO=false                       # roadmap: not implemented in this release

# --- demo ---------------------------------------------------------------------
DEMO_ENABLED=true
DEMO_REFERENCE_ORG_SLUG=aegis-demo

# --- web (Next.js) ------------------------------------------------------------
# Server-side base the web BFF proxies to (inside Docker: http://api:8000).
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
