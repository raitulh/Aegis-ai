# Local development settings for the API and worker (read from backend/.env).
ENV=development
DATABASE_URL=postgresql+psycopg://databattles:databattles@localhost:5432/databattles
SECRET_KEY=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/storage
EMAIL_BACKEND=console
EMAIL_STORE_BODIES=true
EVALUATOR_SANDBOX=subprocess
DEMO_MODE=true
# Optional: GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET / GITHUB_WEBHOOK_SECRET / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
