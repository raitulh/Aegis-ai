    {
      "type": "stat",
      "title": "HTTP 5xx ratio",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "expr": "sum(rate(aegis_http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(aegis_http_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
