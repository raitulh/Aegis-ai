    {
      "type": "stat",
      "title": "Scrape targets up",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "expr": "sum(up{job=~\"aegis-.*\"})",
          "legendFormat": "up",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "Aegis processes currently answering their /metrics endpoint."
    },
    {
