# syntax=docker/dockerfile:1.7
# ==============================================================================
# Aegis AI — API / worker image (Python 3.12 + uv)
# Runs the FastAPI service (uvicorn) or the Celery worker. Same image, different
# command (see docker-compose.yml).
# ==============================================================================

FROM python:3.12-slim AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:/root/.local/bin:$PATH"

# libpq is needed at runtime by psycopg[binary]; curl is used by the container healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# uv (pinned) — fast, reproducible resolver honouring uv.lock.
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /bin/

WORKDIR /app

# ---- dependency layer (cached until the lockfile changes) --------------------
# Copy only the manifests the workspace members reference, then sync from the lock.
COPY pyproject.toml uv.lock ./
COPY packages/sdk/python/pyproject.toml packages/sdk/python/
COPY packages/mcp/pyproject.toml packages/mcp/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# ---- application source ------------------------------------------------------
COPY apps/api apps/api
COPY engines engines
COPY workers workers
COPY database database
COPY alembic.ini ./
COPY packages/sdk/python packages/sdk/python
COPY packages/mcp packages/mcp
COPY scripts scripts
COPY docker/init.sh docker/init.sh

# engines/ and apps/api are import roots; database/ holds the Alembic env + migrations.
ENV PYTHONPATH="/app/apps/api:/app:/app/packages/sdk/python:/app/packages/mcp"

# Non-root runtime user.
RUN useradd --system --create-home --uid 10001 aegis \
    && mkdir -p /app/var/storage \
    && chown -R aegis:aegis /app
USER aegis

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
    CMD curl -fsS http://localhost:8000/health || exit 1

# Default: serve the API. Overridden to `celery ... worker` for the worker service.
CMD ["uvicorn", "aegis_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
